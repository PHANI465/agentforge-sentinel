{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ModelProvenance": {
      "additionalProperties": false,
      "description": "v1.1: which accepted offline experiment produced a model score.",
      "properties": {
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "candidate": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Candidate",
          "type": "string"
        },
        "feature_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Feature Version",
          "type": "string"
        },
        "protocol_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Protocol Sha256",
          "type": "string"
        },
        "protocol_version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Protocol Version",
          "type": "string"
        },
        "results_id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Results Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selection_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Selection Sha256",
          "type": "string"
        },
        "threshold_source": {
          "const": "validation_frozen_threshold",
          "title": "Threshold Source",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "protocol_sha256",
        "selection_sha256",
        "candidate",
        "artifact_sha256",
        "feature_version",
        "threshold_source",
        "results_id"
      ],
      "title": "ModelProvenance",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "session_id"
      ],
      "title": "Scope",
      "type": "object"
    },
    "ScoringInputs": {
      "additionalProperties": false,
      "description": "v1.1: the exact decision-time feature values a model scored (f1), and what they were\ncomputed from. Hidden truth, scenario and future disclosures are never part of it.",
      "properties": {
        "currency": {
          "enum": [
            "USD",
            "INR",
            "GBP",
            "JPY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "disclosures_used": {
          "minimum": 0,
          "title": "Disclosures Used",
          "type": "integer"
        },
        "feature_version": {
          "const": "f1",
          "title": "Feature Version",
          "type": "string"
        },
        "history_rows": {
          "minimum": 0,
          "title": "History Rows",
          "type": "integer"
        },
        "profile_home_currency": {
          "enum": [
            "USD",
            "INR",
            "GBP",
            "JPY"
          ],
          "title": "Profile Home Currency",
          "type": "string"
        },
        "profile_opened_at": {
          "format": "date-time",
          "title": "Profile Opened At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "maximum": 9000000000000000,
            "minimum": -1,
            "type": "integer"
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "feature_version",
        "values",
        "currency",
        "history_rows",
        "disclosures_used",
        "profile_home_currency",
        "profile_opened_at"
      ],
      "title": "ScoringInputs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The recorded decision for one ingested transaction, alerting or not.",
  "properties": {
    "alerted": {
      "title": "Alerted",
      "type": "boolean"
    },
    "features": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "features_as_of": {
      "format": "date-time",
      "title": "Features As Of",
      "type": "string"
    },
    "inputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScoringInputs"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "model": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelProvenance"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prior_count_1h": {
      "maximum": 9000000000000,
      "minimum": 0,
      "title": "Prior Count 1H",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "score": {
      "maximum": 1,
      "minimum": 0,
      "title": "Score",
      "type": "number"
    },
    "score_semantics": {
      "enum": [
        "heuristic",
        "estimated_probability",
        "uncalibrated_score"
      ],
      "title": "Score Semantics",
      "type": "string"
    },
    "scored_at": {
      "format": "date-time",
      "title": "Scored At",
      "type": "string"
    },
    "scorer": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "scoring_kind": {
      "enum": [
        "rule",
        "model"
      ],
      "title": "Scoring Kind",
      "type": "string"
    },
    "threshold": {
      "maximum": 1,
      "minimum": 0,
      "title": "Threshold",
      "type": "number"
    },
    "threshold_policy": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "transaction_id": {
      "format": "uuid",
      "title": "Transaction Id",
      "type": "string"
    }
  },
  "required": [
    "transaction_id",
    "scope",
    "scored_at",
    "features_as_of",
    "scorer",
    "features",
    "threshold_policy",
    "scoring_kind",
    "score_semantics",
    "score",
    "threshold",
    "alerted",
    "prior_count_1h"
  ],
  "title": "ScoringOutcome",
  "type": "object"
}
