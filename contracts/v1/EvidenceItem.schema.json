{
  "$defs": {
    "Fact": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "amount_minor",
            "transaction_count_1h",
            "account_age_days"
          ],
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "maximum": 9000000000000,
          "minimum": 0,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "session_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "available_at": {
      "format": "date-time",
      "title": "Available At",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "source": {
      "enum": [
        "synthetic_transaction",
        "historical_aggregate"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_ref": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Source Ref",
      "type": "string"
    }
  },
  "required": [
    "id",
    "scope",
    "case_id",
    "source",
    "source_ref",
    "observed_at",
    "available_at",
    "facts",
    "content_sha256"
  ],
  "title": "EvidenceItem",
  "type": "object"
}
