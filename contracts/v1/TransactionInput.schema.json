{
  "$defs": {
    "Money": {
      "additionalProperties": false,
      "description": "Positive magnitude; direction is separate. Integers remain safe in JavaScript.",
      "properties": {
        "currency": {
          "enum": [
            "USD",
            "INR",
            "GBP",
            "JPY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "currency_exponent": {
          "maximum": 2,
          "minimum": 0,
          "title": "Currency Exponent",
          "type": "integer"
        },
        "minor_units": {
          "exclusiveMinimum": 0,
          "maximum": 9000000000000,
          "title": "Minor Units",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "minor_units",
        "currency_exponent"
      ],
      "title": "Money",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Untrusted input: no scope, source provenance, labels, actor or credentials.",
  "properties": {
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "amount": {
      "$ref": "#/$defs/Money"
    },
    "direction": {
      "enum": [
        "debit",
        "credit"
      ],
      "title": "Direction",
      "type": "string"
    },
    "external_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "External Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "external_id",
    "account_id",
    "amount",
    "direction",
    "occurred_at"
  ],
  "title": "TransactionInput",
  "type": "object"
}
