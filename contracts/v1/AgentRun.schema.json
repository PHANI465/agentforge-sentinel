{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RunBudget": {
      "additionalProperties": false,
      "properties": {
        "max_delegations": {
          "default": 0,
          "maximum": 2,
          "minimum": 0,
          "title": "Max Delegations",
          "type": "integer"
        },
        "max_output_tokens": {
          "default": 1024,
          "maximum": 4096,
          "minimum": 1,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "max_steps": {
          "default": 4,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_tool_calls": {
          "default": 4,
          "maximum": 16,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 60,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "RunBudget",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "session_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "budget": {
      "$ref": "#/$defs/RunBudget"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "case_revision": {
      "maximum": 2147483647,
      "minimum": 1,
      "title": "Case Revision",
      "type": "integer"
    },
    "config": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "failure_code": {
      "anyOf": [
        {
          "enum": [
            "provider_unavailable",
            "timeout",
            "invalid_output",
            "budget_exhausted"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Code"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "input_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Snapshot Sha256",
      "type": "string"
    },
    "principal_id": {
      "format": "uuid",
      "title": "Principal Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "evidence_analyst",
        "investigator",
        "reviewer"
      ],
      "title": "Role",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "inconclusive",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool_profile": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "id",
    "scope",
    "case_id",
    "case_revision",
    "role",
    "principal_id",
    "config",
    "tool_profile",
    "input_snapshot_sha256",
    "budget",
    "status"
  ],
  "title": "AgentRun",
  "type": "object"
}
