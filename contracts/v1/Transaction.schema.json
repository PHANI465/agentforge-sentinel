{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Money": {
      "additionalProperties": false,
      "description": "Positive magnitude; direction is separate. Integers remain safe in JavaScript.",
      "properties": {
        "currency": {
          "enum": [
            "USD",
            "INR",
            "GBP",
            "JPY"
          ],
          "title": "Currency",
          "type": "string"
        },
        "currency_exponent": {
          "maximum": 2,
          "minimum": 0,
          "title": "Currency Exponent",
          "type": "integer"
        },
        "minor_units": {
          "exclusiveMinimum": 0,
          "maximum": 9000000000000,
          "title": "Minor Units",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "currency",
        "minor_units",
        "currency_exponent"
      ],
      "title": "Money",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "tenant_id": {
          "format": "uuid",
          "title": "Tenant Id",
          "type": "string"
        }
      },
      "required": [
        "tenant_id",
        "session_id"
      ],
      "title": "Scope",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "format": "uuid",
      "title": "Account Id",
      "type": "string"
    },
    "amount": {
      "$ref": "#/$defs/Money"
    },
    "dataset": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "direction": {
      "enum": [
        "debit",
        "credit"
      ],
      "title": "Direction",
      "type": "string"
    },
    "external_id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "External Id",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "ingested_at": {
      "format": "date-time",
      "title": "Ingested At",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "synthetic": {
      "const": true,
      "default": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "external_id",
    "account_id",
    "amount",
    "direction",
    "occurred_at",
    "id",
    "scope",
    "ingested_at",
    "dataset"
  ],
  "title": "Transaction",
  "type": "object"
}
