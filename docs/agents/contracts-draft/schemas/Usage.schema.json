      "default": null,
      "title": "Input Tokens"
    },
    "measured": {
      "title": "Measured",
      "type": "boolean"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output Tokens"
    },
    "schema_version": {
