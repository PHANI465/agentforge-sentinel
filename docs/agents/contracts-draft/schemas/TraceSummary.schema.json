{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "evidence",
            "tool_result"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "g3a-draft-1",
          "default": "g3a-draft-1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ClaimCheck": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "reason": {
          "enum": [
            "value_mismatch",
            "citation_not_in_scope",
            "fact_not_in_cited_record",
            "fact_was_available",
            "verified"
          ],
          "title": "Reason",
          "type": "string"
        },
        "schema_version": {
          "const": "g3a-draft-1",
          "default": "g3a-draft-1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "uncheckable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "index",
        "status",
        "reason"
      ],
      "title": "ClaimCheck",
      "type": "object"
    },
    "Disposition": {
      "additionalProperties": false,
      "description": "Coordinator outcome. recommend/abstain produce exactly one server-built intent;\ninconclusive produces none and reopens the case.",
      "properties": {
        "basis_run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis Run Id"
        },
        "inconclusive_code": {
          "anyOf": [
            {
              "enum": [
                "provider_unavailable",
                "timeout",
                "invalid_output",
                "budget_exhausted",
                "stale_evidence_snapshot"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inconclusive Code"
        },
        "kind": {
          "enum": [
            "recommend",
            "abstain",
            "inconclusive"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation": {
          "anyOf": [
            {
              "enum": [
                "simulated_hold",
                "escalate"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation"
        },
        "reason_code": {
          "anyOf": [
            {
              "enum": [
                "velocity_pattern",
                "unusual_amount",
                "insufficient_evidence"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        },
        "schema_version": {
          "const": "g3a-draft-1",
          "default": "g3a-draft-1",
          "title": "Schema Version",
          "type": "string"
        },
        "supported_claims": {
          "minimum": 0,
          "title": "Supported Claims",
          "type": "integer"
        },
        "unsupported_claims": {
          "minimum": 0,
          "title": "Unsupported Claims",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "supported_claims",
        "unsupported_claims"
      ],
      "title": "Disposition",
      "type": "object"
    },
    "FactClaim": {
      "additionalProperties": false,
      "description": "`fact` relation `value`, cited to where the server can read that exact value.",
      "properties": {
        "cite": {
          "$ref": "#/$defs/Citation"
        },
        "fact": {
          "enum": [
            "amount_minor",
            "transaction_count_1h",
            "large_amount_rule_hit",
            "history_count_24h",
            "history_count_7d",
            "history_median_amount_minor_30d",
            "history_max_amount_minor_30d",
            "account_age_days",
            "prior_known_fraud"
          ],
          "title": "Fact",
          "type": "string"
        },
        "kind": {
          "const": "fact",
          "title": "Kind",
          "type": "string"
        },
        "relation": {
          "enum": [
            "eq",
            "gte",
            "lte"
          ],
          "title": "Relation",
          "type": "string"
        },
        "schema_version": {
          "const": "g3a-draft-1",
          "default": "g3a-draft-1",
          "title": "Schema Version",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "kind",
        "fact",
        "relation",
        "value",
        "cite"
      ],
      "title": "FactClaim",
      "type": "object"
    },
    "MissingEvidenceClaim": {
      "additionalProperties": false,
      "description": "The role says this fact was not available; the server checks that it really was not.",
      "properties": {
        "fact": {
          "enum": [
            "amount_minor",
            "transaction_count_1h",
            "large_amount_rule_hit",
            "history_count_24h",
            "history_count_7d",
            "history_median_amount_minor_30d",
            "history_max_amount_minor_30d",
            "account_age_days",
            "prior_known_fraud"
          ],
          "title": "Fact",
          "type": "string"
        },
        "kind": {
          "const": "missing",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "g3a-draft-1",
          "default": "g3a-draft-1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fact"
      ],
      "title": "MissingEvidenceClaim",
      "type": "object"
    },
    "ToolResult": {
      "additionalProperties": false,
      "description": "Server-produced, digest-addressed. `values` hold only FactKey -> integer/bool values\ncomputed from records available at the case decision time (alert.created_at).",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "denial": {
          "anyOf": [
            {
              "enum": [
                "unknown_tool",
                "budget_exhausted",
                "not_in_profile",
                "schema_rejected"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denial"
        },
        "evidence_ids": {
          "default": [],
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Evidence Ids",
          "type": "array"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "const": "g3a-draft-1",
          "default": "g3a-draft-1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "unavailable",
            "denied"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool": {
          "enum": [
            "case_evidence",
            "scoring_outcome",
            "account_history",
            "account_profile"
          ],
          "title": "Tool",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "propertyNames": {
            "enum": [
              "amount_minor",
              "transaction_count_1h",
              "large_amount_rule_hit",
              "history_count_24h",
              "history_count_7d",
              "history_median_amount_minor_30d",
              "history_max_amount_minor_30d",
              "account_age_days",
              "prior_known_fraud"
            ]
          },
          "title": "Values",
          "type": "object"
        },
        "window": {
          "anyOf": [
            {
              "enum": [
                "24h",
                "7d",
                "30d"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Window"
        }
      },
      "required": [
        "id",
        "tool",
        "status",
        "as_of",
        "content_sha256"
      ],
      "title": "ToolResult",
      "type": "object"
    },
    "TraceRole": {
      "additionalProperties": false,
      "properties": {
        "agent_run_id": {
          "format": "uuid",
          "title": "Agent Run Id",
          "type": "string"
        },
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimCheck"
          },
          "maxItems": 12,
          "title": "Checks",
          "type": "array"
        },
        "claims": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "fact": "#/$defs/FactClaim",
                "missing": "#/$defs/MissingEvidenceClaim"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/FactClaim"
              },
              {
                "$ref": "#/$defs/MissingEvidenceClaim"
              }
            ]
          },
          "maxItems": 12,
          "title": "Claims",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 400,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Untrusted; render as inert text.",
          "title": "Note"
        },
        "role": {
          "enum": [
            "evidence_analyst",
            "investigator",
            "reviewer"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "g3a-draft-1",
          "default": "g3a-draft-1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed",
            "inconclusive",
            "cancelled"
          ],
          "title": "Status",
          "type": "string"
        },
        "verdict": {
          "anyOf": [
            {
              "enum": [
                "accept",
                "challenge",
                "abstain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verdict"
        }
      },
      "required": [
        "role",
        "agent_run_id",
        "attempt",
        "status"
      ],
      "title": "TraceRole",
      "type": "object"
    },
    "WorkflowRecord": {
      "additionalProperties": false,
      "description": "Proposed table agent_workflows: one row per coordinator attempt on a case.",
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "case_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "title": "Case Revision",
          "type": "integer"
        },
        "config": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "deadline_at": {
          "format": "date-time",
          "title": "Deadline At",
          "type": "string"
        },
        "disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/Disposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "input_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Snapshot Sha256",
          "type": "string"
        },
        "role_invocations": {
          "maximum": 8,
          "minimum": 0,
          "title": "Role Invocations",
          "type": "integer"
        },
        "schema_version": {
          "const": "g3a-draft-1",
          "default": "g3a-draft-1",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "status": {
          "enum": [
            "running",
            "completed",
            "inconclusive"
          ],
          "title": "Status",
          "type": "string"
        },
        "tool_calls": {
          "maximum": 12,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "tool_profile": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "id",
        "case_id",
        "case_revision",
        "config",
        "tool_profile",
        "input_snapshot_sha256",
        "status",
        "started_at",
        "deadline_at",
        "role_invocations",
        "tool_calls"
      ],
      "title": "WorkflowRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Proposed additive v1.2 read model (G3C); not required by the G3B slice.",
  "properties": {
    "roles": {
      "items": {
        "$ref": "#/$defs/TraceRole"
      },
      "maxItems": 8,
      "title": "Roles",
      "type": "array"
    },
    "schema_version": {
      "const": "g3a-draft-1",
      "default": "g3a-draft-1",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_results": {
      "items": {
        "$ref": "#/$defs/ToolResult"
      },
      "maxItems": 12,
      "title": "Tool Results",
      "type": "array"
    },
    "workflow": {
      "$ref": "#/$defs/WorkflowRecord"
    }
  },
  "required": [
    "workflow",
    "roles",
    "tool_results"
  ],
  "title": "TraceSummary",
  "type": "object"
}
