{
  "additionalProperties": false,
  "description": "Coordinator outcome. recommend/abstain produce exactly one server-built intent;\ninconclusive produces none and reopens the case.",
  "properties": {
    "basis_run_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Basis Run Id"
    },
    "inconclusive_code": {
      "anyOf": [
        {
          "enum": [
            "provider_unavailable",
            "timeout",
            "invalid_output",
            "budget_exhausted",
            "stale_evidence_snapshot"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inconclusive Code"
    },
    "kind": {
      "enum": [
        "recommend",
        "abstain",
        "inconclusive"
      ],
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "anyOf": [
        {
          "enum": [
            "simulated_hold",
            "escalate"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation"
    },
    "reason_code": {
      "anyOf": [
        {
          "enum": [
            "velocity_pattern",
            "unusual_amount",
            "insufficient_evidence"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "schema_version": {
      "const": "g3a-draft-1",
      "default": "g3a-draft-1",
      "title": "Schema Version",
      "type": "string"
    },
    "supported_claims": {
      "minimum": 0,
      "title": "Supported Claims",
      "type": "integer"
    },
    "unsupported_claims": {
      "minimum": 0,
      "title": "Unsupported Claims",
      "type": "integer"
    }
  },
  "required": [
    "kind",
    "supported_claims",
    "unsupported_claims"
  ],
  "title": "Disposition",
  "type": "object"
}
