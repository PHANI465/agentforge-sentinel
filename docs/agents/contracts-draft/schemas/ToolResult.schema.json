{
  "additionalProperties": false,
  "description": "Server-produced, digest-addressed. `values` hold only FactKey -> integer/bool values\ncomputed from records available at the case decision time (alert.created_at).",
  "properties": {
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "denial": {
      "anyOf": [
        {
          "enum": [
            "unknown_tool",
            "budget_exhausted",
            "not_in_profile",
            "schema_rejected"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Denial"
    },
    "evidence_ids": {
      "default": [],
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidence Ids",
      "type": "array"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "g3a-draft-1",
      "default": "g3a-draft-1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "unavailable",
        "denied"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool": {
      "enum": [
        "case_evidence",
        "scoring_outcome",
        "account_history",
        "account_profile"
      ],
      "title": "Tool",
      "type": "string"
    },
    "values": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "propertyNames": {
        "enum": [
          "amount_minor",
          "transaction_count_1h",
          "large_amount_rule_hit",
          "history_count_24h",
          "history_count_7d",
          "history_median_amount_minor_30d",
          "history_max_amount_minor_30d",
          "account_age_days",
          "prior_known_fraud"
        ]
      },
      "title": "Values",
      "type": "object"
    },
    "window": {
      "anyOf": [
        {
          "enum": [
            "24h",
            "7d",
            "30d"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Window"
    }
  },
  "required": [
    "id",
    "tool",
    "status",
    "as_of",
    "content_sha256"
  ],
  "title": "ToolResult",
  "type": "object"
}
